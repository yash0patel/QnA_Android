<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/backgroundColor">

    <!-- Improved Heading (rounded gradient background) -->
    <TextView
        android:id="@+id/tvHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_heading"
        android:gravity="center"
        android:textColor="@color/headingTextColor"
        android:textSize="20sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <!-- Question card -->
    <RelativeLayout
        android:id="@+id/questionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeading"
        android:layout_marginTop="18dp"
        android:padding="18dp"
        android:background="@color/white"
        android:elevation="3dp"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="18sp"
            android:textColor="@color/textPrimary"
            android:lineSpacingExtra="4dp"/>
    </RelativeLayout>

    <!-- Options -->
    <Button
        android:id="@+id/btnOption1"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/questionCard"
        android:layout_marginTop="18dp"
        android:text="Option 1"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="@color/primaryColor"
        android:textColor="@color/white"
        android:stateListAnimator="@null"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"/>

    <Button
        android:id="@+id/btnOption2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/btnOption1"
        android:layout_marginTop="12dp"
        android:text="Option 2"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="@color/primaryColor"
        android:textColor="@color/white"
        android:stateListAnimator="@null"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"/>

    <Button
        android:id="@+id/btnOption3"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/btnOption2"
        android:layout_marginTop="12dp"
        android:text="Option 3"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="@color/primaryColor"
        android:textColor="@color/white"
        android:stateListAnimator="@null"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"/>

    <Button
        android:id="@+id/btnOption4"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/btnOption3"
        android:layout_marginTop="12dp"
        android:text="Option 4"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="@color/primaryColor"
        android:textColor="@color/white"
        android:stateListAnimator="@null"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"/>

    <!-- End Quiz Button -->
    <Button
        android:id="@+id/btnEndQuiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnOption4"
        android:layout_marginTop="18dp"
        android:layout_centerHorizontal="true"
        android:text="End Quiz"
        android:backgroundTint="@color/textSecondary"
        android:textColor="@color/white"
        android:paddingLeft="24dp"
        android:paddingRight="24dp" />

    <!-- Centered ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_centerInParent="true"
        android:visibility="gone"/>

</RelativeLayout>
